<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2QD.HellForge.dll: a plugin of HD2 Mod Quick Deploy that launches HellForge (an offline
       Helldivers 2 of its own) and manages its mods through HellForge's documented command line.
       It shares no types with the manager: its methods take and give strings, numbers,
       delegates and Json shapes only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2QD.HellForge</AssemblyName>
    <RootNamespace>Hd2Qd.HellForge</RootNamespace>
    <Version>0.9.3</Version>
    <Product>HD2QD HellForge</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)\..=src</PathMap>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- the text, one file per language (Lang\<tag>.json), embedded as Lang.<tag>.json: Words.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
    <!-- its icon: the title-bar button an official plugin gets (the manager reads the resource app.ico) -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HellForge.Tests" />
  </ItemGroup>

</Project>
